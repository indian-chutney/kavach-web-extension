{
  "manifest_version": 2,
  "name": "Kavach Extension",
  "version": "1.0",

  "description": "An Extension for blocking malicious sites and nsfw content",

  "icons": {
    "48": "./assets/icon-48.svg"
  },

  "browser_action": {
    "default_popup": "./popup/popup.html",
    "default_title": "Kavach",
    "default_icon": "./assets/icon-48.svg"
  },

  "background": {
    "scripts": ["background.bundle.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.bundle.js"]
    }
  ],

  "permissions": [
    "webRequest",
    "scripting",
    "storage",
    "webRequestBlocking",
    "<all_urls>"
  ]
}
