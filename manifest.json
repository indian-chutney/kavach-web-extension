{
  "manifest_version": 2,
  "name": "Kavach Extension",
  "version": "1.0",

  "description": "An Extension for blocking malicious sites and nsfw content",

  "icons": {
    "48": "icons/icon-48.png"
  },

  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kavach",
    "default_icon": "icons/icon-48"
  },

  "background": {
    "scripts": ["background/bg.js"]
  },

  "content_scripts": [
    "matches" : ["<all_urls>"],
    "js" : ["content_script/script.js"],
  ],

  "permissions": ["webRequest", "windows", "scripting", "storage"]
}
